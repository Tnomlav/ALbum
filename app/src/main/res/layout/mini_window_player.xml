<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating window's video. `surface_type="texture_view"` matters: a
  SurfaceView is composited in its own layer and ignores the rounded outline of
  the window, so the picture looked square while the window's black background
  was round. A TextureView is an ordinary view and gets clipped.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
